# EmailJS — copy to .env and fill in. Also add these in the Vercel dashboard
# under Settings > Environment Variables.
#
# The public key is designed to be exposed client-side, but keeping the service
# and template ids out of the repo means nobody can burn your monthly quota
# straight from the source. Also lock the allowed origins in the EmailJS
# dashboard (Account > Security) to your own domains.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
